---
layout: layouts/base.njk
---
<article>
  <h1>{{ title }}</h1>
  {% if page.date %}
  <p class="meta"><time datetime="{{ page.date.toISOString() }}">{{ page.date.toISOString().slice(0, 10) }}</time></p>
  {% endif %}
  <p class="translation-note translation-note--top">Nazali na elikya ya solo ete ndembo ezali malamu — mbala mingi ezali na mwa mabunga.</p>
  <div class="post-body">
  {{ content | safe }}
  </div>
</article>
{% include "get-involved.njk" %}
{% set prevPost = collections.publishedPosts | getPreviousCollectionItem(page) %}
{% set nextPost = collections.publishedPosts | getNextCollectionItem(page) %}
{% if prevPost or nextPost %}
<p class="post-nav__hint">{% if nextPost and prevPost %}Balola na lobɔ́kɔ́ la mwasi mpo na makomi oyo ya nsima · Balola na lobɔ́kɔ́ la mobali mpo na makomi oyo ya liboso{% elif nextPost %}Balola na lobɔ́kɔ́ la mwasi mpo na makomi oyo ya nsima{% else %}Balola na lobɔ́kɔ́ la mobali mpo na makomi oyo ya liboso{% endif %}</p>
<nav class="post-nav" aria-label="More writing">
  {% if prevPost %}<a class="post-nav__prev" href="{{ prevPost.url }}">← {{ prevPost.data.title }}</a>{% endif %}
  {% if nextPost %}<a class="post-nav__next" href="{{ nextPost.url }}">{{ nextPost.data.title }} →</a>{% endif %}
</nav>
{% endif %}
{% include "comments.njk" %}
